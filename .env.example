# ===================== AlphaCrew 配置模板 =====================
# 复制为 .env 并填入你的密钥

# ---------- LLM 模型路由（用户可在前端 UI 切换，.env 为默认值）----------
# 默认模型：agnes / deepseek / openai（任意 OpenAI 兼容端点）
ALPHACREW_LLM_PROVIDER=deepseek
ALPHACREW_LLM_MODEL=deepseek-chat

# --- DeepSeek ---
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# --- Agnes（Sapiens AI，OpenAI 兼容协议）---
AGNES_API_KEY=your-agnes-key
# base_url 写到 /v1 为止，SDK 会自动拼 /chat/completions
AGNES_BASE_URL=https://api.agnes-ai.cn/v1

# --- OpenAI（可选备用）---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# 规划器/写手用较强模型，审稿/守护用轻量模型可降本
ALPHACREW_PLANNER_MODEL=
ALPHACREW_CRITIC_MODEL=

# ---------- 金融数据 ----------
ALPHA_VANTAGE_API_KEY=your-alphavantage-key
# Yahoo Finance 无 key 限制较少，留空即可

# ---------- 向量库 / 缓存 ----------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=alphacrew_financial
REDIS_URL=redis://localhost:6379/0

# ---------- 嵌入模型（本地 3060 可跑 bge-small 或改用 API 嵌入）----------
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 或用 API 嵌入：EMBEDDING_PROVIDER=deepseek + EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ---------- 可观测（可选）----------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3001

# ---------- 服务 ----------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173
